# ── Base de datos (Neon) ─────────────────────────────────────────────
# Con la integración Neon ↔ Vercel estas dos se crean solas en cada entorno
# (producción usa la rama main; cada preview recibe su propia rama).
# Pooled (host con "-pooler"): la usa la app.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/ciclo?sslmode=require"
# Directa (sin "-pooler"): la usan las migraciones.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/ciclo?sslmode=require"

# ── Auth.js ──────────────────────────────────────────────────────────
# Genera con: npx auth secret   (o: openssl rand -base64 33)
AUTH_SECRET=""
# Solo estos correos pueden iniciar sesión (separados por coma).
ALLOWED_EMAILS="tu-correo@gmail.com"
# Enlace mágico por correo con Resend (gratis 3,000/mes). Sin dominio propio usa onboarding@resend.dev.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Ciclo <onboarding@resend.dev>"

# ── Cron ─────────────────────────────────────────────────────────────
# Vercel lo envía como "Authorization: Bearer <CRON_SECRET>". Mínimo 32 caracteres.
CRON_SECRET=""

# ── Notificaciones (v1, opcionales) ──────────────────────────────────
# Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@gmail.com"
TELEGRAM_BOT_TOKEN=""

# ── Solo para scripts locales ────────────────────────────────────────
SEED_EMAIL="tu-correo@gmail.com"
